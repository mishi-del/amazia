# Frontend — API (empty in dev; Vite proxies /api)
# VITE_API_URL=https://api.yourdomain.com

# WhatsApp floating button (digits only, e.g. 923001234567)
# VITE_WHATSAPP_NUMBER=

# Meta Ads (browser pixel + server CAPI via /api/meta/event)
# VITE_META_PIXEL_ID=
# VITE_GA4_ID=G-XXXXXXXXXX
# META_ACCESS_TOKEN=          # server only — for Conversion API on Render/Railway
# META_PIXEL_ID=              # server only — same as VITE_META_PIXEL_ID

# Firebase Auth (required for sign up / Google) — see SETUP-FIREBASE.txt
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB — reviews & newsletter (not login; login is Firebase)
MONGODB_URI=memory

# Optional — smarter AI chatbot
# ANTHROPIC_API_KEY=
